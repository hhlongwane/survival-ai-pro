# ==============================================================================
# SURVIVAL AI RECREATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real API keys, secrets, OAuth tokens, private keys, or seed phrases.
# - This independent recreation never connects to or modifies hhlongwane/survival-ai.
# - Live trading execution is DISABLED BY DEFAULT (SURVIVAL_ALLOW_LIVE_EXECUTION=false).
# ==============================================================================

# 1. PostgreSQL Durable Storage (Required)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# 2. Application Security & Environment Mode
NODE_ENV="development"
APP_ENV="sandbox"
SURVIVAL_ADMIN_TOKEN="replace_with_32_byte_random_admin_token"
SURVIVAL_WEBHOOK_SECRET="replace_with_webhook_hmac_secret"
SURVIVAL_ALLOW_LIVE_EXECUTION="false"

# 3. Crypto Exchange Credentials (Optional — Public Market & Paper Trading Run Without Keys)
# Leave empty unless verified live read/trade permissions are explicitly authorized.
KRAKEN_API_KEY=""
KRAKEN_API_SECRET=""
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# 4. PayPal Integration (Sandbox Only unless Live Explicitly Authorized)
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="replace_with_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="replace_with_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="replace_with_paypal_sandbox_webhook_id"

# 5. cTrader Open API OAuth 2.0 Integration
CTRADER_CLIENT_ID="replace_with_ctrader_open_api_client_id"
CTRADER_CLIENT_SECRET="replace_with_ctrader_open_api_client_secret"
CTRADER_REDIRECT_URI="http://localhost:3000/api/integrations/ctrader/callback"
CTRADER_APP_APPROVED="false"

# 6. MetaTrader 5 Demo Bridge
MT5_BRIDGE_URL=""
MT5_BRIDGE_TOKEN=""
MT5_DEMO_ONLY="true"

# 7. Shopify & Business Revenue Integration
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""

# 8. Privacy & Retention (POPIA Compliance)
DATA_RETENTION_DAYS="90"
ANONYMIZE_CUSTOMER_RECORDS="true"
